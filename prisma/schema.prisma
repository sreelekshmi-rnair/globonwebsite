datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id               Int      @id @default(autoincrement())
  category         String   @default("loans-advances")
  categoryTitle    String?  @default("")
  title            String
  slug             String   @unique
  subtitle         String?  @default("")
  shortDesc        String?  @db.Text
  heroImage        String?  @default("")
  overviewTitle    String?  @default("")
  overviewDesc     String?  @db.Text
  overviewImage    String?  @default("")
  overviewBullets  String?  @db.LongText
  features         String?  @db.LongText
  optionsBadge     String?  @default("")
  optionsTitle     String?  @default("")
  options          String?  @db.LongText
  documentGroups   String?  @db.LongText
  advisoryNote     String?  @db.Text
  eligibilityDesc  String?  @db.Text
  feesDesc         String?  @db.Text
  faqs             String?  @db.LongText
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Loan {
  id                Int      @id @default(autoincrement())
  title             String
  slug              String   @unique
  category          String   @default("General Loan")
  interestRate      String   @default("8.5% p.a.")
  maxAmount         String   @default("Up to ₹50 Lakhs")
  tenure            String   @default("1 to 5 Years")
  processingFee     String?  @default("0.5%")
  shortDescription  String   @db.Text
  description       String   @db.Text
  eligibility       String   @default("") @db.Text
  documentsRequired String   @default("") @db.Text
  benefits          String   @default("") @db.Text
  icon              String?
  image             String?
  isPopular         Boolean  @default(false)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Blog {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  category    String   @default("Business")
  author      String   @default("Globon Team")
  excerpt     String   @db.Text
  content     String   @db.Text
  image       String?
  date        String?  @default("")
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inquiry {
  id             Int      @id @default(autoincrement())
  fullName       String
  email          String   @default("")
  phoneNumber    String
  subject        String?  @default("")
  message        String?  @default("") @db.Text
  businessName   String?  @default("")
  industry       String?  @default("")
  businessAge    String?  @default("")
  monthlyRevenue String?  @default("")
  serviceNeeded  String?  @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContactMessage {
  id             Int      @id @default(autoincrement())
  name           String   @default("")
  phoneNumber    String   @default("")
  email          String   @default("")
  subject        String   @default("")
  messageSnippet String   @default("") @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

